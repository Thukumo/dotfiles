{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "flake inputs",
      "automerge": false
    }
  ],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": false,
  "automerge": false,
  "dependencyDashboard": true
}
